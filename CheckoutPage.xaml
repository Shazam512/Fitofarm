<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P3.CheckoutPage"
             Title="Оформление заказа">

    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <BoxView Color="#00C618" HeightRequest="100" Grid.Row="0" />
        <Image Source="logo.png" HorizontalOptions="Center" MaximumHeightRequest="90" Grid.Row="0" />

        <!-- Кнопка профиля -->
        <Button Text="Профиль пользователя" 
                Clicked="OnProfileButtonClicked" 
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                FontSize="24" 
                Margin="0,10" 
                BackgroundColor="#00C618" 
                CornerRadius="5" 
                Padding="10" 
                Grid.Row="1" />

        <!-- Выбор пункта выдачи и способа оплаты -->
        <StackLayout Padding="20" Grid.Row="2">
            <Label Text="Выберите пункт выдачи" FontSize="20" />
            <Picker x:Name="PickupLocationPicker" Title="Выберите пункт выдачи">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Аптека 1</x:String>
                        <x:String>Аптека 2</x:String>
                        <x:String>Аптека 3</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Label LineHeight="1.5" />

            <Label Text="Выберите способ оплаты" FontSize="20" />
            <Picker x:Name="PaymentMethodPicker" Title="Выберите способ оплаты">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Кредитная карта</x:String>
                        <x:String>Наличные</x:String>
                        <x:String>Перевод</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Label LineHeight="1.5" />
        </StackLayout>

        <!-- Итоговая цена и кнопка подтверждения заказа -->
        <StackLayout Grid.Row="3" Padding="20" VerticalOptions="End" HorizontalOptions="FillAndExpand">
            <Label x:Name="TotalPriceLabel" LineHeight="1.5" FontSize="24" HorizontalOptions="Center" />
            <Label LineHeight="1.5" />
            <Button Text="Подтвердить заказ" 
                    Clicked="OnConfirmOrderClicked" 
                    VerticalOptions="End" 
                    HorizontalOptions="Center" 
                    FontSize="24" 
                    BackgroundColor="#00C618" 
                    CornerRadius="5" 
                    Padding="10" />
        </StackLayout>
    </Grid>
</ContentPage>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P3.RegistrationPage"
             Title="Регистрация">
    <ScrollView>
        <!-- Основная сетка с отступом вокруг содержимого -->
        <Grid Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <BoxView Color="#00C618" HeightRequest="100" Grid.Row="0" />
            <Image Source="logo.png" HorizontalOptions="Center" MaximumHeightRequest="90" Grid.Row="0" />

            <!-- Контейнер для формы регистрации, центрируется по горизонтали -->
            <Grid Grid.Row="1" HorizontalOptions="Center" Padding="20">
                <Frame Padding="20" CornerRadius="10" HasShadow="True" VerticalOptions="Center" HorizontalOptions="Center">
                    <StackLayout Spacing="15">
                        <Label Text="Регистрация" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#00C618" />

                        <Entry x:Name="LoginEntry" Placeholder="Логин" Margin="0,10,0,0" Keyboard="Text" Focused="OnEntryFocused" />

                        <Entry x:Name="PhoneEntry" Placeholder="Номер телефона" Keyboard="Telephone" Focused="OnEntryFocused" />

                        <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True" Keyboard="Text" Focused="OnEntryFocused" />

                        <Button Text="Зарегистрироваться" Clicked="OnRegisterClicked" BackgroundColor="#00C618" CornerRadius="5" />
                    </StackLayout>
                </Frame>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
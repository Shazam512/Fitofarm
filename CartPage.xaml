<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P3.CartPage"
             Title="Корзина">
    <Grid Padding="10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <BoxView Color="#00C618" HeightRequest="100" Grid.Row="0" />
        <Image Source="logo.png" HorizontalOptions="Center" MaximumHeightRequest="90" Grid.Row="0" />

        <Grid Grid.Row="1" ColumnSpacing="20" Padding="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Text="Главная"
                    Clicked="OnMainPageButtonClicked"
                    FontSize="20"
                    BackgroundColor="#00C618"
                    HorizontalOptions="FillAndExpand"
                    Grid.Column="0" />

            <Button Text="Профиль"
                    Clicked="OnProfileButtonClicked"
                    FontSize="20"
                    BackgroundColor="#00C618"
                    HorizontalOptions="FillAndExpand"
                    Grid.Column="1" />
        </Grid>

        <ScrollView Grid.Row="2" VerticalOptions="FillAndExpand" Margin="0,10,0,0">
            <CollectionView x:Name="CartCollectionView" SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="5" CornerRadius="10" HasShadow="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image Source="{Binding ImageUrl}" HeightRequest="100" Aspect="AspectFill" Grid.Column="0" VerticalOptions="Center" />

                                <StackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="{Binding Price, StringFormat='Цена: {0:C}'}" FontSize="14" LineHeight="1.5" TextColor="Gray" />
                                </StackLayout>

                                <Button Text="Удалить"
                                        Clicked="OnRemoveButtonClicked"
                                        BackgroundColor="#FF3B30"
                                        Padding="10,5"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Grid.Column="2" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <Label x:Name="TotalPriceLabel"
               FontSize="28"
               HorizontalOptions="End"
               FontAttributes="Bold"
               Grid.Row="3"
               Margin="0,10" />

        <Button Text="Оформить заказ"
                Clicked="OnCheckoutButtonClicked"
                VerticalOptions="End"
                HorizontalOptions="Center"
                FontSize="24"
                Margin="0,10"
                BackgroundColor="#00C618"
                Grid.Row="4" />
    </Grid>
</ContentPage>